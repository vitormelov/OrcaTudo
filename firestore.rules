rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function tokenEmail() {
      return isSignedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function isAdminEmail() {
      return tokenEmail() == 'vitormelov@gmail.com';
    }

    function isAdmin() {
      return isAdminEmail() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true
      );
    }

    function isUsuarioBloqueado() {
      return isSignedIn() &&
        !isAdmin() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.bloqueado == true;
    }

    function isVinculado(empresaId) {
      return isSignedIn() && empresaId is string &&
        exists(/databases/$(database)/documents/empresas/$(empresaId)/membros/$(request.auth.uid));
    }

    function empresaAtiva(empresaId) {
      return empresaId is string &&
        exists(/databases/$(database)/documents/empresas/$(empresaId)) &&
        get(/databases/$(database)/documents/empresas/$(empresaId)).data.bloqueada != true;
    }

    function isMember(empresaId) {
      return isSignedIn() && !isUsuarioBloqueado() && empresaId is string && (
        isAdmin() ||
        (empresaAtiva(empresaId) && isVinculado(empresaId))
      );
    }

    function isColaborador(empresaId) {
      return isAdmin() || (
        isMember(empresaId) &&
        get(/databases/$(database)/documents/empresas/$(empresaId)/membros/$(request.auth.uid)).data.colaborador == true
      );
    }

    function ownsLegacy(data) {
      return isSignedIn() && !isUsuarioBloqueado() && data.userId == request.auth.uid;
    }

    function canWriteTenant(data) {
      return ('empresaId' in data && data.empresaId is string)
        ? isColaborador(data.empresaId)
        : ownsLegacy(data);
    }

    match /usuarios/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == uid &&
        request.resource.data.isAdmin == resource.data.isAdmin
      );
      allow delete: if isAdmin();
    }

    match /empresas/{empresaId} {
      allow read: if isAdmin() || isVinculado(empresaId);
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.criouEmpresa != true
      );
      allow update, delete: if isAdmin();

      match /membros/{uid} {
        allow read: if isAdmin() || request.auth.uid == uid || isMember(empresaId);
        allow create: if isAdmin() || (
          isSignedIn() &&
          request.auth.uid == uid &&
          empresaAtiva(empresaId)
        );
        allow update, delete: if isAdmin();
      }
    }

    match /empresasPorCnpj/{cnpj} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && cnpj.matches('^[0-9]{14}$')
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.criouEmpresa != true
      );
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.createdBy == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /logsAcesso/{logId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.acao is string;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /documentosFiscais/{docId} {
      allow get: if isAdmin() || (
        isSignedIn() && resource.data.uid == request.auth.uid
      );
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.cpfCnpj == docId
        && request.resource.data.trialUsado == true
        && (docId.matches('^[0-9]{11}$'));
      allow update, delete: if isAdmin();
    }

    match /insumos/{document} {
      allow create: if isColaborador(request.resource.data.empresaId)
        && request.resource.data.userId == request.auth.uid;
      allow read: if isMember(resource.data.empresaId) || ownsLegacy(resource.data);
      allow update, delete: if canWriteTenant(resource.data);
    }

    match /insumos/{insumoId}/precos/{precoId} {
      allow read: if isSignedIn() && (
        isMember(get(/databases/$(database)/documents/insumos/$(insumoId)).data.empresaId) ||
        request.auth.uid == get(/databases/$(database)/documents/insumos/$(insumoId)).data.userId
      );
      allow write: if isSignedIn() && canWriteTenant(
        getAfter(/databases/$(database)/documents/insumos/$(insumoId)).data
      );
    }

    match /composicoes/{document} {
      allow create: if isColaborador(request.resource.data.empresaId)
        && request.resource.data.userId == request.auth.uid;
      allow read: if isMember(resource.data.empresaId) || ownsLegacy(resource.data);
      allow update, delete: if canWriteTenant(resource.data);
    }

    match /orcamentos/{document} {
      allow create: if isColaborador(request.resource.data.empresaId)
        && request.resource.data.userId == request.auth.uid;
      allow read: if isMember(resource.data.empresaId) || ownsLegacy(resource.data);
      allow update, delete: if canWriteTenant(resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
